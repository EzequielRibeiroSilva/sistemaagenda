# ========================================
# VARIÁVEIS DE AMBIENTE - DESENVOLVIMENTO
# ========================================
# ATENÇÃO: Este é um arquivo de exemplo
# Copie para .env e ajuste os valores
# NUNCA commite o arquivo .env no Git!
# ========================================

# ========================================
# APLICAÇÃO
# ========================================
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ========================================
# JWT SECRETS (OBRIGATÓRIO)
# ========================================
# CRÍTICO: Mínimo 32 caracteres em produção
# NUNCA use os valores de exemplo em produção!
# Use: node scripts/generate-secrets.js
JWT_SECRET=sua_chave_secreta_jwt_aqui_deve_ser_muito_segura_minimo_32_caracteres
JWT_REFRESH_SECRET=sua_chave_refresh_jwt_aqui_deve_ser_muito_segura_minimo_32_caracteres
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# ========================================
# BANCO DE DADOS (OBRIGATÓRIO)
# ========================================
PG_HOST=localhost
PG_PORT=5432
PG_USER=seu_usuario_postgres
PG_PASSWORD=sua_senha_postgres
PG_DATABASE=painel_agendamento_dev

# URL de conexão completa (alternativa)
# DATABASE_URL=postgresql://seu_usuario:sua_senha@localhost:5432/painel_agendamento_dev

# ========================================
# IDENTIFICAÇÃO DA APLICAÇÃO
# ========================================
# Nome da aplicação usado como fallback para instâncias WhatsApp
APP_NAME=PAINEL-DE-AGENDAMENTOS
# Token padrão para criação de instâncias Evolution API
EVOLUTION_DEFAULT_TOKEN=PAINEL-DE-AGENDAMENTOS

# ========================================
# EVOLUTION API (WHATSAPP)
# ========================================
# WhatsApp Integration (Evolution API)
WHATSAPP_ENABLED=true
WHATSAPP_TEST_MODE=false
EVOLUTION_API_URL=https://ssesmt-evolution-api-evolution-api.mpra0p.easypanel.host
EVOLUTION_API_KEY=SUA_API_KEY_AQUI
EVOLUTION_INSTANCE_NAME=PAINEL-DE-AGENDAMENTOS

# Configurações legadas (manter para compatibilidade)
EVO_API_BASE_URL=https://ssesmt-evolution-api-evolution-api.mpra0p.easypanel.host/
EVO_API_INTERNAL_URL=http://ssesmt-evolution-api_evolution-api:8080/
EVO_API_INSTANCE_ID=D29738C28C8D-4035-8DEF-F2F49364E590
EVO_API_KEY=SUA_API_KEY_AQUI
AUTHENTICATION_API_KEY=SUA_API_KEY_AQUI

# ========================================
# AGENDAMENTO
# ========================================
DEFAULT_BOOKING_ADVANCE_HOURS=2
DEFAULT_FUTURE_BOOKING_DAYS=365
DEFAULT_CANCELLATION_HOURS=4
DEFAULT_SERVICE_DURATION_HOURS=1

# ========================================
# NOTIFICAÇÕES
# ========================================
ENABLE_WHATSAPP_NOTIFICATIONS=true
REMINDER_24H_ENABLED=true
REMINDER_1H_ENABLED=true
SUBSCRIPTION_REMINDER_DAYS=7

# ========================================
# SEGURANÇA
# ========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
BCRYPT_SALT_ROUNDS=12

# ========================================
# CORS
# ========================================
# Desenvolvimento: Separe múltiplas origens com vírgula
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001

# Produção: Whitelist de domínios permitidos (OBRIGATÓRIO EM PRODUÇÃO)
# Exemplo: CORS_PRODUCTION_ORIGINS=https://app.tally.com.br,https://tally.com.br
CORS_PRODUCTION_ORIGINS=

# ========================================
# REDIS (OBRIGATÓRIO EM PRODUÇÃO)
# ========================================
# Deixe em branco para usar fallback de memória em desenvolvimento
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========================================
# LOGS
# ========================================
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ========================================
# SESSÃO (IA CHAT)
# ========================================
# Tempo em minutos de inatividade antes de reativar sessões pausadas por humanos
# Padrão: 15 minutos (sessões pausadas por mais tempo são automaticamente reativadas)
SESSION_INACTIVITY_TIMEOUT_MINUTES=15

# ========================================
# DESENVOLVIMENTO — TÚNEL NGROK
# ========================================
# Usado apenas em NODE_ENV=development para receber webhooks da Evolution API
# no localhost via túnel público. Atualizado automaticamente por `npm run tunnel`.
# ⚠️  NÃO defina esta variável em produção.
# WEBHOOK_BASE_URL=https://xxxx-xxxx.ngrok-free.app

# ========================================
# OPENROUTER & IA (Recepcionista Virtual)
# ========================================
# Chave de acesso ao OpenRouter (https://openrouter.ai)
# Usada pelo ChatCompletionService e AiAgentService para comunicação com a LLM.
OPENROUTER_API_KEY=sua_chave_openrouter_aqui
# Modelo a usar (ex: meta-llama/llama-3-8b-instruct:free para dev gratuito)
OPENROUTER_MODEL_DEV=meta-llama/llama-3-8b-instruct:free
