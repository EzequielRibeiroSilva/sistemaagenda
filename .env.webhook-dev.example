# ==========================================
# CONFIGURAÇÃO PARA TESTES DE WEBHOOK (DEV)
# ==========================================
# 
# Este arquivo contém as configurações necessárias para testar
# o webhook do Mercado Pago localmente sem validação de assinatura.
#
# IMPORTANTE: Use APENAS em ambiente de desenvolvimento!
#
# Para usar:
# cp .env.webhook-dev.example .env
# ==========================================

# 🔓 BYPASS DE SEGURANÇA (Obrigatório para testes locais)
NODE_ENV=development

# 🌐 Porta do Servidor Backend
PORT=3001

# 🔐 Configurações JWT (valores de exemplo - gere novos em produção)
JWT_SECRET=9fd1646f4cd43179ce05ad42cc52fb815f0c9b2cb4e8f5e45559bd3848f61e865bf907c71592abeedc8cdc0a4a0894b50c87234cf59ffc657848379bbb23ac81
JWT_REFRESH_SECRET=dd43d8192cd3d2b59b2a434b63eae82736ceb9698b810620079568d9b1c44898b5fc96736275b5d298c57d0963530fccb676fc193f7713aff18b701e24efa608
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# 🗄️ Configurações do PostgreSQL - DESENVOLVIMENTO LOCAL
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=painel_agendamento_dev

# 🔗 URL de conexão completa (alternativa)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/painel_agendamento_dev

# 💳 Mercado Pago (Sandbox/Teste)
# IMPORTANTE: Em desenvolvimento, o webhook NÃO valida a assinatura!
MP_ACCESS_TOKEN=APP_USR-SEU_TOKEN_DE_TESTE_AQUI
MP_WEBHOOK_SECRET=seu_webhook_secret_aqui_opcional_em_dev

# 📱 WhatsApp (Evolution API)
# Configure se quiser testar notificações WhatsApp
WHATSAPP_ENABLED=true
WHATSAPP_TEST_MODE=false
EVO_API_BASE_URL=https://sua-evolution-api.com/
EVO_API_INSTANCE_ID=sua-instancia-id
EVO_API_KEY=sua-api-key
EVOLUTION_API_URL=https://sua-evolution-api.com/
EVOLUTION_API_KEY=sua-api-key
EVOLUTION_INSTANCE_NAME=PAINEL-DE-AGENDAMENTOS

# ⏰ Configurações de Agendamento
DEFAULT_BOOKING_ADVANCE_HOURS=2
DEFAULT_FUTURE_BOOKING_DAYS=365
DEFAULT_CANCELLATION_HOURS=4
DEFAULT_SERVICE_DURATION_HOURS=1

# 🔔 Notificações
ENABLE_WHATSAPP_NOTIFICATIONS=true
REMINDER_24H_ENABLED=true
REMINDER_1H_ENABLED=true
SUBSCRIPTION_REMINDER_DAYS=7

# 🔒 Segurança
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5000
BCRYPT_SALT_ROUNDS=12

# 📊 Logs
LOG_LEVEL=info
LOG_FILE=logs/app.log

# 🧠 Sessão (IA Chat)
SESSION_INACTIVITY_TIMEOUT_MINUTES=15

# 🔴 Redis (opcional)
# REDIS_PASSWORD=sua-senha-redis

# ==========================================
# INSTRUÇÕES DE USO
# ==========================================
#
# 1. Copie este arquivo para .env:
#    cp .env.webhook-dev.example .env
#
# 2. Ajuste os valores de banco de dados se necessário
#
# 3. Certifique-se de que NODE_ENV=development está definido
#
# 4. Inicie o servidor:
#    cd backend && npm run dev
#
# 5. Teste o webhook:
#    node backend/test-webhook-local.js <MP_PAYMENT_ID>
#
# ==========================================
# AVISOS DE SEGURANÇA
# ==========================================
#
# ⚠️ NUNCA use NODE_ENV=development em produção!
# ⚠️ O bypass de validação DESATIVA a segurança do webhook!
# ⚠️ Apenas para testes locais em localhost!
#
# Em produção, use NODE_ENV=production e configure:
# - MP_WEBHOOK_SECRET com o valor real do Mercado Pago
# - Validação de assinatura SEMPRE ativa
# - HTTPS obrigatório para o webhook
#
# ==========================================
